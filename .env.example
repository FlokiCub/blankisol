APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# WhatsApp Configuration
# Provider options: 'log' | 'local' | 'meta' | 'http' | 'ultramsg' | 'wati' | 'gupshup' | 'twilio' | 'custom'
WHATSAPP_PROVIDER=log

# ──────────────────────────────────────────────
# Gateway Local (Baileys) - Solo si WHATSAPP_PROVIDER=local
# En local: http://127.0.0.1:3333
# En producción: URL donde esté accesible el gateway (ej: https://tu-dominio.com:3333)
WHATSAPP_LOCAL_URL=http://127.0.0.1:3333
WHATSAPP_LOCAL_KEY=scgi_local_key_2026

# ──────────────────────────────────────────────
# Meta Cloud API - Solo si WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_BASE_URL=https://graph.facebook.com

# ──────────────────────────────────────────────
# HTTP API Providers (Ultramsg, Wati, Gupshup, Twilio, Custom)
# Solo si WHATSAPP_PROVIDER=http|ultramsg|wati|gupshup|twilio|custom
WHATSAPP_HTTP_PROVIDER=ultramsg          # 'ultramsg' | 'wati' | 'gupshup' | 'twilio' | 'custom'
WHATSAPP_HTTP_BASE_URL=https://api.ultramsg.com
WHATSAPP_HTTP_INSTANCE_ID=               # Instance ID / Account SID / Source Number
WHATSAPP_HTTP_TOKEN=                     # Token / API Key / Password

# Ejemplos por proveedor:
# Ultramsg:     BASE_URL=https://api.ultramsg.com     INSTANCE_ID=instance1234  TOKEN=token_xxx
# Wati:         BASE_URL=https://live.wati.io         INSTANCE_ID=YOUR_API_KEY  TOKEN=Bearer xxx (en headers)
# Gupshup:      BASE_URL=https://api.gupshup.io       INSTANCE_ID=source_number TOKEN=api_key
# Twilio:       BASE_URL=https://api.twilio.com       INSTANCE_ID=AccountSid    TOKEN=AuthToken
# Custom:       BASE_URL=https://tu-gateway.com       INSTANCE_ID=...           TOKEN=...

# Para 'custom' define payload_template en config/services.php → whatsapp.http.payload_template
# Placeholders: {phone}, {text}, {token}, {instance_id}, {template_name}, {param_0}, {param_1}...

WHATSAPP_WEBHOOK_VERIFY_TOKEN=scgi_secure_wa_webhook_token_2026
